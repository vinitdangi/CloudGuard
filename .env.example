# Backend environment. Set a random 32+ character secret in production.
CLOUDGUARD_ENVIRONMENT=development
CLOUDGUARD_SESSION_SECRET=replace-with-a-random-secret-before-production
CLOUDGUARD_ALLOWED_ORIGINS=http://localhost:3000

# Optional path for the local SQLite database.
CLOUDGUARD_AUTH_DB=

# Optional PostgreSQL URL; when set, it takes precedence over CLOUDGUARD_AUTH_DB.
# On Railway, reference the PostgreSQL service's DATABASE_URL variable.
DATABASE_URL=

# Streamlit email registration verification (SMTP). Use app secrets in production.
CLOUDGUARD_OTP_SECRET=replace-with-a-random-32-character-or-longer-secret
CLOUDGUARD_SMTP_HOST=
CLOUDGUARD_SMTP_PORT=587
CLOUDGUARD_SMTP_USERNAME=
CLOUDGUARD_SMTP_PASSWORD=
CLOUDGUARD_EMAIL_FROM=
